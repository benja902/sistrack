APP_ENV=development
API_V1_PREFIX=/api/v1
# Vercel: use the project Supabase Transaction Pooler URI with sslmode=require.
DATABASE_URL=
# standard for local/session or direct connections; transaction for Vercel.
DATABASE_POOL_MODE=standard
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
TEMPORARY_REGISTERED_BY_USER_ID=00000000-0000-0000-0000-000000000301
# IA: la clave vacía permite utilizar el fallback determinista.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=5
