# Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-before-enabling-authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend (copy this value to frontend/.env when running Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
