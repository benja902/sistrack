# Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
# Vercel: use the project Supabase Transaction Pooler URI with sslmode=require.
DATABASE_URL=
# standard for local/session or direct connections; transaction for Vercel.
DATABASE_POOL_MODE=standard
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
TEMPORARY_REGISTERED_BY_USER_ID=00000000-0000-0000-0000-000000000301

# Frontend (copy this value to frontend/.env when running Vite)
VITE_API_BASE_URL=/api/v1
# IA: configurar únicamente en backend; nunca usar variables VITE para estos valores.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=5
